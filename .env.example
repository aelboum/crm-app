# Local development configuration. Copy to `.env` (untracked) and replace
# every `change-me` value with a local-only value. Never commit `.env`.
#
# In development, SaaS-OS reads secrets and connection strings from `.env`
# (or the process environment, which wins); non-secret settings such as
# PUBLIC_APP_ORIGIN and APP_DB_USER are read from the process environment
# only. `docker compose --env-file .env` uses the same file.

ENVIRONMENT=development

# --- PostgreSQL (deploy/local/compose.yaml, service `db`) -------------------
# POSTGRES_USER is the image's bootstrap role and, locally, the migration
# role. APP_DB_USER is the restricted runtime role (NOSUPERUSER NOBYPASSRLS),
# created by deploy/local/init/01-roles.sh on first start.
POSTGRES_USER=crm_app_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=crm_app
APP_DB_USER=crm_app_runtime
APP_DB_PASSWORD=change-me-runtime
CRM_APP_DB_PORT=55432

DATABASE_URL=postgresql+psycopg://crm_app_runtime:change-me-runtime@127.0.0.1:55432/crm_app
MIGRATIONS_DATABASE_URL=postgresql+psycopg://crm_app_owner:change-me-owner@127.0.0.1:55432/crm_app

# --- Redis (service `redis`) -------------------------------------------------
CRM_APP_REDIS_PORT=56379
REDIS_URL=redis://127.0.0.1:56379/0

# --- Identity: local ZITADEL (profile `identity`) ----------------------------
# ZITADEL and its Login V2 UI are served on the application's own origin
# through the `edge` service (decision D-IDL), so the issuer is the same URL
# as PUBLIC_APP_ORIGIN, for the browser and for server-side calls alike.
OIDC_ISSUER_URL=http://localhost:8000
# Printed by `saas-os-local-identity` (see README.md); assigned by ZITADEL.
OIDC_CLIENT_ID=
# Always empty: the local application is a public PKCE client.
OIDC_CLIENT_SECRET=
# The provider's end-session endpoint (its discovery document's
# `end_session_endpoint`). After signing out of the application the browser
# goes there, so the identity provider's session ends too. Its return address
# `<PUBLIC_APP_ORIGIN>/app` must be registered on the application
# (`deploy/local/configure-zitadel.py` does this locally). Empty: sign-out
# ends the application session only.
OIDC_END_SESSION_ENDPOINT=http://localhost:8000/oidc/v1/end_session
OIDC_LOCAL_PROJECT_NAME=crm-app
OIDC_LOCAL_APPLICATION_NAME=crm-app-backend

# Exactly 32 characters, for example: openssl rand -hex 16
ZITADEL_LOCAL_MASTERKEY=change-me-32-characters-exactly!
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=change-me-zitadel-db
ZITADEL_DB_NAME=zitadel
ZITADEL_FIRSTINSTANCE_ADMIN_USERNAME=admin
ZITADEL_FIRSTINSTANCE_ADMIN_PASSWORD=Change-me-Admin-1!
ZITADEL_FIRSTINSTANCE_ADMIN_EMAIL=admin@crm-app.localhost
# Signs Login V2's session cookie; at least 32 characters, e.g. openssl rand -base64 32
ZITADEL_LOGIN_SESSION_COOKIE_SECRET=change-me-at-least-32-characters-long

# --- Application --------------------------------------------------------------
# The single browser-visible origin, served by the `edge` service; the
# OIDC callback is derived from it. The application itself listens on
# 127.0.0.1:8001 behind it.
CRM_APP_PUBLIC_PORT=8000
PUBLIC_APP_ORIGIN=http://localhost:8000
AUTH_COOKIE_SECURE=false
# Where the browser lands after sign-in: the frontend (crm_app.api.spa).
AUTH_POST_LOGIN_PATH=/app

# --- Invitations (decisions Q4, P2-F) ---------------------------------------------
# manual (default): the invitation link is shown once to the inviter, labelled
# not sent. email: it is sent through SaaS-OS core.email. Locally, use Mailpit
# (docker compose ... --profile mail up -d mailpit) and read mail at
# http://127.0.0.1:58025. Production uses smtp with a provider chosen before
# launch (Q3).
INVITATION_DELIVERY=manual
# EMAIL_PROVIDER=mailpit
# MAILPIT_SMTP_HOST=127.0.0.1
# EMAIL_DEFAULT_SENDER=crm@crm-app.localhost

# --- Self-service signup (decision S-1, docs/project/SIGNUP-PLAN.md) ----------------
# Off unless set to true. Refused in production until every launch gate in the
# plan has passed. Turning it on also needs both limits (no defaults: choose
# them, launch gate LG-6) and TRUST_PROXY_HEADERS=true, so per-client limits
# key on the visitor's address and not on the edge's (security finding L4).
# TRUST_PROXY_HEADERS=true is safe only while the application can be reached
# through the edge alone (here: uvicorn on 127.0.0.1).
# SIGNUP_ENABLED=false
# SIGNUP_MAX_WORKSPACES_PER_USER=
# SIGNUP_MAX_PER_DAY=
# TRUST_PROXY_HEADERS=true

# Never set PLATFORM_CONFIG_DATABASE_URL here: the application and the
# worker refuse to start if they can see it.

# Integration-test configuration. Copy to `.env.test` (untracked), use the
# same passwords as your `.env`, and export it before running the
# integration tests (see README.md). The tests use their own database
# (`crm_app_test`, created by deploy/local/init/01-roles.sh) and Redis
# database 1, so they never touch development data.

ENVIRONMENT=test
APP_DB_USER=crm_app_runtime
DATABASE_URL=postgresql+psycopg://crm_app_runtime:change-me-runtime@127.0.0.1:55432/crm_app_test
MIGRATIONS_DATABASE_URL=postgresql+psycopg://crm_app_owner:change-me-owner@127.0.0.1:55432/crm_app_test
REDIS_URL=redis://127.0.0.1:56379/1
OIDC_ISSUER_URL=http://zitadel.localhost:8081
OIDC_CLIENT_ID=integration-placeholder
PUBLIC_APP_ORIGIN=http://localhost:8000

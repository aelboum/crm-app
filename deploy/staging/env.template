# LeadStack staging and production settings: every name, no value
# (brief H section 7.1 item 5; decision D-STG.4).
#
# Nothing here is a real value. `<...>` marks what the owner's choices fill
# in (provider, domain, accounts); none is chosen yet. Secrets go in the
# host's secret store, never in this file or in git (SaaS-OS ADR-0012); the
# local rehearsal writes its own throwaway values (prepare_local.py).
#
# Marks after each name:
#   [secret]   a credential: secret store only
#   [offline]  also kept offline by the owner; losing it loses data
#   [app] [worker] [migrate] [backup] [zitadel]  who reads it
#
# ----------------------------------------------------------------------------
# Every process
# ----------------------------------------------------------------------------
ENVIRONMENT=production                       # [app] [worker] [migrate]
PUBLIC_APP_ORIGIN=https://<staging-hostname> # [app] [worker]  the one browser origin
TRUST_PROXY_HEADERS=true                     # [app]  behind the edge only (13-H1 F2)
APP_DB_USER=<runtime role name>              # [app] [worker] [migrate]

# ----------------------------------------------------------------------------
# Databases and Redis (managed services; TLS, SaaS-OS ADR-0028)
# ----------------------------------------------------------------------------
# The runtime role: NOSUPERUSER NOBYPASSRLS. Form:
# postgresql+psycopg://<role>:<password>@<host>:<port>/<db>?sslmode=verify-full&sslrootcert=<ca file>
DATABASE_URL=                                # [secret] [app] [worker] [migrate]
# The migration owner: owns the schema; never given to the app or worker.
MIGRATIONS_DATABASE_URL=                     # [secret] [migrate]
# SaaS-OS's platform configuration role: never in the app's or worker's
# environment (SaaS-OS refuses to start if it is).
PLATFORM_CONFIG_DATABASE_URL=                # [secret] operator commands only
PLATFORM_CONFIG_DB_USER=saas_os_platform_config
# Form: rediss://:<password>@<host>:<port>/0
REDIS_URL=                                   # [secret] [app] [worker] [migrate]
# The managed services' CA bundle, when they use a private CA.
SSL_CERT_FILE=<path to the provider's CA>    # [app] [worker] [migrate]

# ----------------------------------------------------------------------------
# Identity (ZITADEL on the app's origin, SaaS-OS ADR-0025)
# ----------------------------------------------------------------------------
OIDC_ISSUER_URL=https://<staging-hostname>   # [app]
OIDC_CLIENT_ID=<assigned by ZITADEL>         # [app]
OIDC_END_SESSION_ENDPOINT=https://<staging-hostname>/oidc/v1/end_session  # [app]
# Only when the issuer's certificate is from a private CA.
OIDC_CA_BUNDLE=                              # [app]
AUTH_POST_LOGIN_PATH=/app                    # [app]
# Self-hosted ZITADEL (an owner decision; ZITADEL Cloud needs none of these).
ZITADEL_MASTERKEY=                           # [secret] [offline] [zitadel]  exactly 32 characters
ZITADEL_DB_PASSWORD=                         # [secret] [zitadel]
ZITADEL_ADMIN_PASSWORD=                      # [secret] [zitadel]  first instance only
ZITADEL_LOGIN_SESSION_COOKIE_SECRET=         # [secret] [zitadel]  32+ characters

# ----------------------------------------------------------------------------
# Encryption, egress and webhooks
# ----------------------------------------------------------------------------
# Field encryption: SaaS-OS keeps customers' webhook signing keys with it
# (decision P12-H). 32 random bytes, standard base64.
FIELD_ENCRYPTION_ACTIVE_KEY_VERSION=v1       # [app] [worker]
FIELD_ENCRYPTION_KEY_V1=                     # [secret] [offline] [app] [worker]
# The worker leaves only through its proxy (SaaS-OS ADR-0059).
EGRESS_PROXY_URL=http://egress-proxy:3128    # [worker]

# ----------------------------------------------------------------------------
# Email (production sending and receiving are NOT authorized; every switch
# below is refused in production until its activation gates pass)
# ----------------------------------------------------------------------------
EMAIL_SENDING_ENABLED=false                  # [app] [worker]
EMAIL_CONVERSATION_SENDING_ENABLED=false     # [app] [worker]
EMAIL_CAMPAIGN_SENDING_ENABLED=false         # [app] [worker]
EMAIL_INBOUND_ENABLED=false                  # [app] [worker]
EMAIL_CUSTOMER_DOMAINS_ENABLED=false         # [app] [worker]
EMAIL_PROVIDER=                              # [app] [worker]  resend, once authorized
EMAIL_DEFAULT_SENDER=                        # [app] [worker]  <name>@notify.<domain>
EMAIL_PARENT_DOMAIN=                         # [app] [worker]  <domain>
RESEND_API_KEY=                              # [secret] [worker]  once authorized
RESEND_WEBHOOK_SECRET=                       # [secret] [app]  once authorized
INVITATION_DELIVERY=                         # [app]  link (default) or email, once authorized

# ----------------------------------------------------------------------------
# Product limits (defaults apply when unset)
# ----------------------------------------------------------------------------
SIGNUP_ENABLED=false                         # [app]  refused in production until LG-1 to LG-10
BOOKING_REQUESTS_PER_VISITOR_PER_HOUR=       # [app]
BOOKING_LOOKUPS_PER_VISITOR_PER_HOUR=        # [app]
BOOKINGS_PER_WORKSPACE_PER_24H=              # [app]

# ----------------------------------------------------------------------------
# Backups (host timers; SaaS-OS docs/BACKUP-RESTORE.md; decision D-STG.2)
# ----------------------------------------------------------------------------
BACKUP_STAGING_DIR=/var/backups/leadstack    # [backup]
BACKUP_ENCRYPTION_RECIPIENT=                 # [backup]  age public key
BACKUP_ENCRYPTION_IDENTITY=                  # [secret] [offline]  restore only; never on the host
BACKUP_OFF_SITE_ENABLED=false                # [backup]  true once a bucket is approved
BACKUP_S3_ENDPOINT_URL=                      # [backup]
BACKUP_S3_BUCKET=                            # [backup]
BACKUP_S3_REGION=                            # [backup]
BACKUP_S3_ACCESS_KEY_ID=                     # [secret] [backup]
BACKUP_S3_SECRET_ACCESS_KEY=                 # [secret] [backup]
ZITADEL_BACKUP_DATABASE_URL=                 # [secret] [backup]

# ----------------------------------------------------------------------------
# Monitoring (host; decision D-STG.3)
# ----------------------------------------------------------------------------
HEARTBEAT_URL=                               # [secret] heartbeat.env only: the monitor's address

# LeadStack's edge (decision D-STG; launch gate 13-H1 F2). The only
# published service: it terminates TLS and reaches nothing but `app`,
# ZITADEL and its Login V2 UI.
#
# - One origin for the app and the identity provider (SaaS-OS ADR-0025,
#   "Topology A"; the same routes as deploy/local/Caddyfile): the browser
#   never leaves it and no identity-provider hostname is shown.
# - X-Forwarded-For is replaced with the client's own address, never
#   appended to: the app (TRUST_PROXY_HEADERS=true) reads its last hop, so a
#   client-sent value can never be taken for the client.
# - Request bodies are capped at the edge, below the app's own limits only
#   where nothing legitimate is larger: 6 MB overall (the 5 MB CSV import
#   plus its form encoding), 64 KB for public routes (the largest is the
#   signed provider webhook, 64 KB).
# - The admin API is off. Locally the certificate comes from the local CA
#   (prepare_local.py), which is also the only CA the app trusts for its
#   issuer (OIDC_CA_BUNDLE); a host uses a public certificate instead.
# - The site's address (`STAGING_SITE`) and its TLS (`edge/site-*.caddy`)
#   are chosen by compose's `EDGE_MODE`: `local` (default) or `host`
#   (decision D-STG.5: Let's Encrypt, HSTS, plain HTTP redirected).
{
	admin off
	auto_https disable_redirects
}

import /etc/caddy/extra.caddy

# Provider cookies (Login V2's `sessions` cookie holds ZITADEL session
# tokens) share this host with the application. They must never reach the
# application (SaaS-OS ADR-0025 section 9).
(strip_provider_cookies) {
	route {
		request_header Cookie "(?:^|;\s*)(?:(?:__Host-|__Secure-)?zitadel\.[^=;]*|sessions|fingerprintId|verificationCheck|NEXT_LOCALE)=[^;]*" ""
		request_header Cookie "^;\s*" ""
		@no_cookie_left not header_regexp Cookie \S
		request_header @no_cookie_left -Cookie
	}
}

# ZITADEL and Login V2 read these ahead of Host to choose their instance; a
# browser must never choose it.
(drop_client_zitadel_host_headers) {
	header_up -X-Zitadel-Instance-Host
	header_up -X-Zitadel-Public-Host
	header_up -X-Zitadel-Forward-Host
}

(client_address) {
	header_up X-Forwarded-For {remote_host}
	header_up -X-Real-IP
	header_up -Forwarded
}

{$STAGING_SITE} {
	import /etc/caddy/site.caddy

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@public path /v1/public/*
	request_body @public {
		max_size 64KB
	}
	request_body {
		max_size 6MB
	}

	@login_v2 path /ui/v2/login /ui/v2/login/*
	handle @login_v2 {
		reverse_proxy zitadel-login:3000 {
			import drop_client_zitadel_host_headers
			import client_address
		}
	}

	# ZITADEL v4.19.x's documented public routes (SaaS-OS ADR-0025 section
	# 5). Re-check when the pinned ZITADEL version changes.
	@zitadel path /v2/* /v2beta/* /zitadel.* /admin/v1/* /auth/v1/* /management/v1/* /system/v1/* /assets/v1/* /oidc/v1/* /saml/v2/* /oauth/v2/* /device /device/* /.well-known/openid-configuration /.well-known/apple-app-site-association /.well-known/assetlinks.json /openapi/* /idps/callback /idps/callback/* /ui/console /ui/console/* /ui/login /ui/login/*
	handle @zitadel {
		reverse_proxy h2c://zitadel:8080 {
			import drop_client_zitadel_host_headers
			import client_address
		}
	}

	# A browser that hits the sign-in rate limit gets a short page instead of
	# the API's JSON (staging finding S-14); the limit itself is the app's.
	@auth path /auth/*
	handle @auth {
		import strip_provider_cookies
		reverse_proxy app:8000 {
			import client_address
			@limited status 429
			handle_response @limited {
				header Content-Type "text/html; charset=utf-8"
				header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'"
				header Retry-After "60"
				respond <<HTML
					<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Too many attempts</title><body style="font-family:system-ui,sans-serif;max-width:32rem;margin:4rem auto;padding:0 1rem"><h1 style="font-size:1.25rem">Too many sign-in attempts</h1><p>Wait a minute, then try again.</p><p><a href="/app">Back to LeadStack</a></p></body></html>
					HTML 429
			}
		}
	}

	handle {
		import strip_provider_cookies
		reverse_proxy app:8000 {
			import client_address
		}
	}
}

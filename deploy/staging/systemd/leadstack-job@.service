# One scheduled LeadStack or SaaS-OS command, run once in the product image
# against the stack (decision D-STG.3; docs/project/OPERATIONS.md). The
# instance name is the Python module: `leadstack-job@crm_app.email_maintenance`.
# Host-level, like SaaS-OS's own units (deploy/*.service at the pinned
# commit): it must keep working when the worker does not, and it needs no
# Docker socket inside any container.
#
# Install on the host (paths are placeholders until a host is chosen):
#   sudo cp deploy/staging/systemd/* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now leadstack-*.timer saas-os-*.timer
# A non-zero exit is a failed unit (`systemctl --failed`), which the
# heartbeat and host monitoring see.

[Unit]
Description=LeadStack scheduled command %i
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/leadstack/deploy/staging
ExecStart=/usr/bin/docker compose --env-file /opt/leadstack/deploy/staging/.env -f /opt/leadstack/deploy/staging/compose.yaml run --rm --no-deps -T app python -m %i
TimeoutStartSec=900

# Every 5 minutes: worker and queue health, then the monitoring heartbeat (decision D-STG.3).

[Unit]
Description=LeadStack timer: Every 5 minutes: worker and queue health, then the monitoring heartbeat

[Timer]
OnCalendar=*:0/5
Persistent=true
RandomizedDelaySec=0
Unit=leadstack-heartbeat.service

[Install]
WantedBy=timers.target

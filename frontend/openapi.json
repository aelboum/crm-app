    "/auth/logout": {
      "post": {
        "description": "Revokes the *current* session only (the existing, idempotent\n`revoke_session`) and clears the cookie. Requires a valid session --\nan unauthenticated or already-revoked credential gets the same 401\nevery other route returns, and learns nothing about other sessions.",
